# Copy to .env.local and fill in. Without a key the app runs in demo (mock) mode.
ANTHROPIC_API_KEY=
# Optional: anthropic (default when a key is set) or mock
LLM_PROVIDER=
# Optional: model per tier. Defaults: free = claude-haiku-5-5, paid = claude-sonnet-5-5
ANTHROPIC_MODEL_FREE=
ANTHROPIC_MODEL_PAID=

# --- Billing (Paddle). Without PADDLE_API_KEY, local dev uses mock billing (paying activates instantly).
# BILLING_PROVIDER=paddle | mock (optional; default is paddle when PADDLE_API_KEY is set)
BILLING_PROVIDER=
PADDLE_API_KEY=
# sandbox (default) or production
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=
# Client-side token and environment for Paddle.js on /pay
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Price ids (pri_...) from Paddle > Catalog. A plan without a price id is not offered.
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
# Shown on our upgrade card only; Paddle's checkout shows the real price. Paddle bills GCC in USD.
PLAN_PRO_MONTHLY_DISPLAY_PRICE=
PLAN_PRO_YEARLY_DISPLAY_PRICE=
# Free tailored packs per user per calendar month (Riyadh time). Default 5.
FREE_PACKS_PER_MONTH=
# Signs the anonymous visitor cookie. Required in production: a long random string.
SESSION_SECRET=
