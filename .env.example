# Copy to .env.local and fill in. Without a key the app runs in demo (mock) mode.
ANTHROPIC_API_KEY=
# Optional: anthropic (default when a key is set) or mock
LLM_PROVIDER=
# Optional: model per tier. Defaults: free = claude-haiku-5-5, paid = claude-sonnet-5-5
ANTHROPIC_MODEL_FREE=
ANTHROPIC_MODEL_PAID=
# Database. Leave empty in development to use an embedded Postgres (PGlite) in .data/pglite.
# Required in production: a Postgres connection string.
DATABASE_URL=
# SMS for sign-in codes. In development "dev" prints the code to the server log and the page.
# Required in production; no real provider is wired up yet.
SMS_PROVIDER=

# --- Billing (Paddle). Without PADDLE_API_KEY, development uses mock billing (checkout switches you to Plus at once).
# BILLING_PROVIDER=paddle | mock (optional; default is paddle when PADDLE_API_KEY is set)
BILLING_PROVIDER=
PADDLE_API_KEY=
# sandbox (default) or production
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=
# Client-side token and environment for Paddle.js on /ar/pay
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Price ids (pri_...) from Paddle > Catalog. A plan without a price id is not offered.
PADDLE_PRICE_PLUS_MONTHLY=
PADDLE_PRICE_PLUS_YEARLY=
# Shown on the plans page; Paddle's checkout shows the real, localised price. Paddle bills GCC buyers in USD.
PLAN_PLUS_MONTHLY_DISPLAY_PRICE=
PLAN_PLUS_YEARLY_DISPLAY_PRICE=

# --- Legal pages (/ar/terms, /ar/privacy, /ar/refunds). Paddle's review wants your legal name in the Terms.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_COUNTRY_EN=
LEGAL_COUNTRY_AR=
